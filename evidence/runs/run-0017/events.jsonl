{"case_run_id":127,"created_at":"2026-08-29T22:47:08.944404","event_type":"provider.delta","level":"info","message":"","model_run_id":20,"payload":{"text":"{\"plan\":{\"grain\":\"每行一个订单\",\"sources\":[\"fact_orders\",\"dim_customers\"],\"joins\":[\"fact_orders.customer_id = dim_customers.customer_id\"],\"filters\":[\"fact_orders.status = 'completed'\",\"fact_orders.order_date >= DATE '2026-01-01'\"],\"metrics\":[\"输出订单头 total_amount\"],\"steps\":[\"筛选完成订单及日期范围\",\"连接客户维度获取 customer_name\",\"按 total_amount 降序、order_id 升序排序\"],\"risks\":[\"仅使用订单头 total_amount，不重复汇总订单行\"]},\"sql\":\"SELECT\\n    o.order_id,\\n    c.customer_name,\\n    o.order_date,\\n    o.total_amount\\nFROM fact_orders AS o\\nJOIN dim_customers AS c\\n    ON o.customer_id = c.customer_id\\nWHERE o.status = 'completed'\\n  AND o.order_date >= DATE '2026-01-01'\\nORDER BY o.total_amount DESC, o.order_id ASC;\",\"summary\":\"筛选 2026-01-01 起的已完成订单，连接客户名称，输出订单信息并按订单金额降序、订单号升序排列。\",\"assumptions\":[]}"},"seq":6}
