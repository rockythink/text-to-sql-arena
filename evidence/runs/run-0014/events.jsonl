{"case_run_id":92,"created_at":"2026-08-29T19:55:53.996502","event_type":"provider.delta","level":"info","message":"","model_run_id":17,"payload":{"text":"{\"sql\":\"WITH monthly AS (\\n    SELECT\\n        strftime(o.order_date, '%Y-%m') AS month,\\n        SUM(oi.quantity * oi.unit_price - oi.discount_amount) AS monthly_revenue\\n    FROM fact_orders AS o\\n    JOIN fact_order_items AS oi\\n      ON oi.order_id = o.order_id\\n    WHERE o.status = 'completed'\\n      AND o.order_date >= DATE '2025-01-01'\\n      AND o.order_date < DATE '2026-01-01'\\n    GROUP BY 1\\n), with_previous AS (\\n    SELECT\\n        month,\\n        monthly_revenue,\\n        LAG(monthly_revenue) OVER (ORDER BY month) AS previous_revenue\\n    FROM monthly\\n)\\nSELECT\\n    month,\\n    monthly_revenue,\\n    ROUND(\\n        100.0 * (monthly_revenue - previous_revenue)\\n        / NULLIF(previous_revenue, 0),\\n        2\\n    ) AS mom_pct\\nFROM with_previous\\nORDER BY month ASC;\",\"summary\":\"按月汇总 2025 年完成订单的净销售额，并使用 LAG 计算环比百分比；首个有收入月份为 NULL。\",\"assumptions\":[\"仅输出 2025 年存在完成订单商品行的月份，不补齐无数据月份。\",\"收入采用语义层定义的净销售额：quantity * unit_price - discount_amount。\",\"若上月收入为 0，则该月 mom_pct 返回 NULL，以避免除零。\"]}"},"seq":55}
