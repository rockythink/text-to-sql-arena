{"case_run_id":43,"created_at":"2026-08-29T16:40:01.616839","event_type":"provider.delta","level":"info","message":"","model_run_id":13,"payload":{"text":"{\"sql\":\"WITH monthly AS (\\n  SELECT\\n    strftime(o.order_date, '%Y-%m') AS month,\\n    SUM(oi.quantity * oi.unit_price - oi.discount_amount) AS monthly_revenue\\n  FROM fact_orders AS o\\n  JOIN fact_order_items AS oi\\n    ON oi.order_id = o.order_id\\n  WHERE o.status = 'completed'\\n    AND o.order_date >= DATE '2025-01-01'\\n    AND o.order_date < DATE '2026-01-01'\\n  GROUP BY 1\\n)\\nSELECT\\n  month,\\n  monthly_revenue,\\n  SUM(monthly_revenue) OVER (\\n    ORDER BY month\\n    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\\n  ) AS cumulative_revenue\\nFROM monthly\\nORDER BY month ASC;\",\"summary\":\"按月汇总 2025 年已完成订单的净收入，并使用按月份排序的 SUM 窗口计算累计收入。\",\"assumptions\":[\"收入采用语义层定义的净销售额：quantity * unit_price - discount_amount。\",\"仅输出存在已完成订单收入的月份；无数据月份不补零。\"]}"},"seq":97}
