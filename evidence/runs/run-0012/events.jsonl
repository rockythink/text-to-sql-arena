{"case_run_id":46,"created_at":"2026-08-29T16:41:03.334656","event_type":"provider.delta","level":"info","message":"","model_run_id":13,"payload":{"text":"{\"sql\":\"SELECT\\n    c.channel_type,\\n    SUM(CASE WHEN p.status = 'paid' THEN p.amount ELSE 0 END) AS paid_amount,\\n    SUM(CASE WHEN p.status = 'refunded' THEN p.amount ELSE 0 END) AS refunded_amount,\\n    SUM(CASE WHEN p.status = 'failed' THEN p.amount ELSE 0 END) AS failed_amount\\nFROM fact_payments AS p\\nJOIN fact_orders AS o\\n    ON p.order_id = o.order_id\\nJOIN dim_channels AS c\\n    ON o.channel_id = c.channel_id\\nGROUP BY c.channel_type\\nORDER BY c.channel_type ASC\",\"summary\":\"按渠道类型汇总 paid、refunded 和 failed 三类支付金额，并按渠道类型升序排列。\",\"assumptions\":[]}"},"seq":118}
