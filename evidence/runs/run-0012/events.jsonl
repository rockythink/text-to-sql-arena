{"case_run_id":47,"created_at":"2026-08-29T16:41:27.804929","event_type":"provider.delta","level":"info","message":"","model_run_id":13,"payload":{"text":"{\"sql\":\"WITH sold_by_category AS (\\n    SELECT\\n        p.category,\\n        SUM(oi.quantity) AS sold_qty\\n    FROM fact_orders AS o\\n    JOIN fact_order_items AS oi\\n        ON oi.order_id = o.order_id\\n    JOIN dim_products AS p\\n        ON p.product_id = oi.product_id\\n    WHERE o.status = 'completed'\\n    GROUP BY p.category\\n),\\nreturned_by_category AS (\\n    SELECT\\n        p.category,\\n        SUM(r.return_qty) AS returned_qty\\n    FROM fact_orders AS o\\n    JOIN fact_order_items AS oi\\n        ON oi.order_id = o.order_id\\n    JOIN dim_products AS p\\n        ON p.product_id = oi.product_id\\n    JOIN fact_returns AS r\\n        ON r.order_id = oi.order_id\\n       AND r.line_no = oi.line_no\\n    WHERE o.status = 'completed'\\n    GROUP BY p.category\\n)\\nSELECT\\n    s.category,\\n    s.sold_qty,\\n    COALESCE(r.returned_qty, 0) AS returned_qty,\\n    ROUND(COALESCE(r.returned_qty, 0)::DECIMAL / NULLIF(s.sold_qty, 0), 4) AS return_rate\\nFROM sold_by_category AS s\\nLEFT JOIN returned_by_category AS r\\n    ON r.category = s.category\\nORDER BY return_rate DESC, s.category ASC\",\"summary\":\"分别聚合完成订单各品类的售出量与退货量，再计算退货率并按退货率降序、品类升序输出。\",\"assumptions\":[\"无退货记录的品类 returned_qty 和 return_rate 均按 0 处理。\",\"退货数量仅统计状态为 completed 的订单行所关联的退货记录。\"]}"},"seq":125}
