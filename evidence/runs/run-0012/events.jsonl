{"case_run_id":44,"created_at":"2026-08-29T16:40:26.254045","event_type":"provider.delta","level":"info","message":"","model_run_id":13,"payload":{"text":"{\"sql\":\"WITH monthly AS (\\n    SELECT\\n        strftime(fact_orders.order_date, '%Y-%m') AS month,\\n        SUM(fact_order_items.quantity * fact_order_items.unit_price - fact_order_items.discount_amount) AS monthly_revenue\\n    FROM fact_orders\\n    JOIN fact_order_items\\n      ON fact_order_items.order_id = fact_orders.order_id\\n    WHERE fact_orders.status = 'completed'\\n      AND fact_orders.order_date >= DATE '2025-01-01'\\n      AND fact_orders.order_date < DATE '2026-01-01'\\n    GROUP BY 1\\n), with_previous AS (\\n    SELECT\\n        month,\\n        monthly_revenue,\\n        LAG(monthly_revenue) OVER (ORDER BY month) AS previous_revenue\\n    FROM monthly\\n)\\nSELECT\\n    month,\\n    monthly_revenue,\\n    ROUND((monthly_revenue - previous_revenue) * 100.0 / NULLIF(previous_revenue, 0), 2) AS mom_pct\\nFROM with_previous\\nORDER BY month ASC;\",\"summary\":\"按月汇总 2025 年完成订单的净销售额，并使用 LAG 计算环比百分比；首个有收入月份及上月收入为 0 时环比为 NULL。\",\"assumptions\":[\"收入采用语义层定义的完成订单商品行净销售额。\",\"仅输出 2025 年存在完成订单收入记录的月份，不补齐无记录月份。\"]}"},"seq":104}
