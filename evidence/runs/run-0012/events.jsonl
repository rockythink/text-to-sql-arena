{"case_run_id":48,"created_at":"2026-08-29T16:41:45.327382","event_type":"provider.delta","level":"info","message":"","model_run_id":13,"payload":{"text":"{\"sql\":\"SELECT order_id, payment_id, paid_at, amount\\nFROM (\\n    SELECT\\n        order_id,\\n        payment_id,\\n        paid_at,\\n        amount,\\n        ROW_NUMBER() OVER (\\n            PARTITION BY order_id\\n            ORDER BY paid_at DESC, payment_id DESC\\n        ) AS rn\\n    FROM fact_payments\\n    WHERE status = 'paid'\\n) AS ranked_payments\\nWHERE rn = 1\\nORDER BY order_id ASC;\",\"summary\":\"为每个有成功支付记录的订单返回最新一笔成功支付；支付时间相同时选择 payment_id 较大的记录。\",\"assumptions\":[]}"},"seq":132}
