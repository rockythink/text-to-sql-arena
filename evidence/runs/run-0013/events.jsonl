{"case_run_id":61,"created_at":"2026-08-29T16:43:51.866379","event_type":"provider.delta","level":"info","message":"","model_run_id":15,"payload":{"text":"{\"sql\":\"SELECT\\n    o.order_id,\\n    c.customer_name,\\n    o.order_date,\\n    o.total_amount\\nFROM fact_orders AS o\\nJOIN dim_customers AS c\\n    ON o.customer_id = c.customer_id\\nWHERE o.status = 'completed'\\n  AND o.order_date >= DATE '2026-01-01'\\nORDER BY o.total_amount DESC, o.order_id ASC\",\"summary\":\"查询 2026-01-01 起的已完成订单及客户名称，按订单金额降序、订单 ID 升序排列。\",\"assumptions\":[\"“2026-01-01 起”包含 2026-01-01 当日。\"]}"},"seq":55}
