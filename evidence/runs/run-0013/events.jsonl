{"case_run_id":65,"created_at":"2026-08-29T16:45:03.459111","event_type":"provider.delta","level":"info","message":"","model_run_id":15,"payload":{"text":"{\"sql\":\"SELECT\\n    c.customer_id,\\n    c.customer_name\\nFROM dim_customers AS c\\nWHERE NOT EXISTS (\\n    SELECT 1\\n    FROM fact_orders AS o\\n    WHERE o.customer_id = c.customer_id\\n      AND o.status = 'completed'\\n)\\nORDER BY c.customer_id ASC;\",\"summary\":\"返回从未有已完成订单的客户，并按 customer_id 升序排列。\",\"assumptions\":[]}"},"seq":83}
