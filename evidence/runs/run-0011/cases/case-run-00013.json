  "radar_dimension": "基础查询",
  "raw_output": "{\"sql\":\"SELECT\\n    o.order_id,\\n    c.customer_name,\\n    o.order_date,\\n    o.total_amount\\nFROM fact_orders AS o\\nJOIN dim_customers AS c\\n    ON o.customer_id = c.customer_id\\nWHERE o.status = 'completed'\\n  AND o.order_date >= DATE '2026-01-01'\\nORDER BY o.total_amount DESC, o.order_id ASC;\",\"summary\":\"查询 2026-01-01 起的已完成订单及客户名称，按订单总额降序、订单 ID 升序排列。\",\"assumptions\":[]}",
  "reference_sql": "SELECT o.order_id, c.customer_name, o.order_date, o.total_amount FROM fact_orders o JOIN dim_customers c ON c.customer_id = o.customer_id WHERE o.status = 'completed' AND o.order_date >= DATE '2026-01-01' ORDER BY o.total_amount DESC, o.order_id ASC",
