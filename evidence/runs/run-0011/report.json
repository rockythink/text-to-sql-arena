          "execution_ms": 235.67491699941456,
          "formatted_sql": "WITH sold AS (\n  SELECT\n    p.category,\n    SUM(oi.quantity) AS sold_qty\n  FROM fact_order_items AS oi\n  JOIN fact_orders AS o\n    ON o.order_id = oi.order_id\n  JOIN dim_products AS p\n    ON p.product_id = oi.product_id\n  WHERE\n    o.status = 'completed'\n  GROUP BY\n    p.category\n), returned AS (\n  SELECT\n    p.category,\n    SUM(r.return_qty) AS returned_qty\n  FROM fact_returns AS r\n  JOIN fact_order_items AS oi\n    ON oi.order_id = r.order_id AND oi.line_no = r.line_no\n  JOIN fact_orders AS o\n    ON o.order_id = oi.order_id\n  JOIN dim_products AS p\n    ON p.product_id = oi.product_id\n  WHERE\n    o.status = 'completed'\n  GROUP BY\n    p.category\n), category_rates AS (\n  SELECT\n    s.category,\n    s.sold_qty,\n    COALESCE(r.returned_qty, 0) AS returned_qty,\n    ROUND(CAST(COALESCE(r.returned_qty, 0) AS DECIMAL(18, 3)) / NULLIF(s.sold_qty, 0), 4) AS return_rate\n  FROM sold AS s\n  LEFT JOIN returned AS r\n    ON r.category = s.category\n)\nSELECT\n  category,\n  sold_qty,\n  returned_qty,\n  return_rate\nFROM category_rates\nORDER BY\n  return_rate DESC,\n  category ASC",
