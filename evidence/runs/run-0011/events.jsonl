{"case_run_id":21,"created_at":"2026-08-29T16:28:44.525288","event_type":"provider.delta","level":"info","message":"","model_run_id":11,"payload":{"text":"{\"sql\":\"SELECT\\n    customer_id,\\n    customer_name,\\n    total_spend\\nFROM (\\n    SELECT\\n        customer_id,\\n        customer_name,\\n        total_spend,\\n        AVG(total_spend) OVER () AS avg_total_spend\\n    FROM (\\n        SELECT\\n            c.customer_id,\\n            c.customer_name,\\n            SUM(o.total_amount) AS total_spend\\n        FROM fact_orders AS o\\n        JOIN dim_customers AS c\\n          ON o.customer_id = c.customer_id\\n        WHERE o.status = 'completed'\\n        GROUP BY c.customer_id, c.customer_name\\n    ) AS customer_spend\\n) AS spend_with_average\\nWHERE total_spend > avg_total_spend\\nORDER BY total_spend DESC, customer_id ASC\",\"summary\":\"汇总每位有已完成订单客户的累计消费，以这些客户的平均累计消费为基准，返回高于平均值的客户。\",\"assumptions\":[\"累计已完成消费按已完成订单头的 fact_orders.total_amount 求和。\",\"平均值仅基于至少有一笔已完成订单的客户计算。\"]}"},"seq":111}
