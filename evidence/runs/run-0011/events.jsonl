{"case_run_id":22,"created_at":"2026-08-29T16:29:02.809830","event_type":"provider.delta","level":"info","message":"","model_run_id":11,"payload":{"text":"{\"sql\":\"SELECT\\n    c.channel_type,\\n    SUM(CASE WHEN p.status = 'paid' THEN p.amount ELSE 0 END) AS paid_amount,\\n    SUM(CASE WHEN p.status = 'refunded' THEN p.amount ELSE 0 END) AS refunded_amount,\\n    SUM(CASE WHEN p.status = 'failed' THEN p.amount ELSE 0 END) AS failed_amount\\nFROM fact_payments AS p\\nJOIN fact_orders AS o\\n    ON p.order_id = o.order_id\\nJOIN dim_channels AS c\\n    ON o.channel_id = c.channel_id\\nGROUP BY c.channel_type\\nORDER BY c.channel_type ASC;\",\"summary\":\"按渠道类型汇总成功支付、退款状态和失败支付金额，并按渠道类型升序排列。\",\"assumptions\":[\"支付金额仅依据 fact_payments.status 分类，不限制订单状态。\",\"仅输出存在支付记录的渠道类型。\"]}"},"seq":118}
