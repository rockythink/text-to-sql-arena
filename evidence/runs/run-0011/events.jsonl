{"case_run_id":20,"created_at":"2026-08-29T16:28:24.481691","event_type":"provider.delta","level":"info","message":"","model_run_id":11,"payload":{"text":"{\"sql\":\"WITH months AS (\\n    SELECT month_start\\n    FROM generate_series(\\n        DATE '2025-01-01',\\n        DATE '2025-12-01',\\n        INTERVAL '1 month'\\n    ) AS t(month_start)\\n), monthly AS (\\n    SELECT\\n        date_trunc('month', o.order_date) AS month_start,\\n        SUM(oi.quantity * oi.unit_price - oi.discount_amount) AS monthly_revenue\\n    FROM fact_orders AS o\\n    JOIN fact_order_items AS oi\\n      ON oi.order_id = o.order_id\\n    WHERE o.status = 'completed'\\n      AND o.order_date >= DATE '2025-01-01'\\n      AND o.order_date < DATE '2026-01-01'\\n    GROUP BY 1\\n), with_lag AS (\\n    SELECT\\n        m.month_start,\\n        COALESCE(r.monthly_revenue, 0) AS monthly_revenue,\\n        LAG(COALESCE(r.monthly_revenue, 0)) OVER (ORDER BY m.month_start) AS previous_revenue\\n    FROM months AS m\\n    LEFT JOIN monthly AS r\\n      ON r.month_start = m.month_start\\n)\\nSELECT\\n    strftime(month_start, '%Y-%m') AS month,\\n    monthly_revenue,\\n    ROUND(\\n        100.0 * (monthly_revenue - previous_revenue)\\n        / NULLIF(previous_revenue, 0),\\n        2\\n    ) AS mom_pct\\nFROM with_lag\\nORDER BY month_start;\",\"summary\":\"按月汇总 2025 年完成订单的净销售额，并使用 LAG 计算环比百分比；结果按月份升序。\",\"assumptions\":[\"收入采用语义层定义的完成订单商品行净销售额。\",\"补齐 2025 年全部 12 个月，无收入月份记为 0。\",\"首月或上月收入为 0 时，环比百分比为 NULL。\"]}"},"seq":104}
