{"case_run_id":23,"created_at":"2026-08-29T16:29:25.546200","event_type":"provider.delta","level":"info","message":"","model_run_id":11,"payload":{"text":"{\"sql\":\"WITH sold AS (\\n    SELECT\\n        p.category,\\n        SUM(oi.quantity) AS sold_qty\\n    FROM fact_order_items AS oi\\n    JOIN fact_orders AS o\\n      ON o.order_id = oi.order_id\\n    JOIN dim_products AS p\\n      ON p.product_id = oi.product_id\\n    WHERE o.status = 'completed'\\n    GROUP BY p.category\\n),\\nreturned AS (\\n    SELECT\\n        p.category,\\n        SUM(r.return_qty) AS returned_qty\\n    FROM fact_returns AS r\\n    JOIN fact_order_items AS oi\\n      ON oi.order_id = r.order_id\\n     AND oi.line_no = r.line_no\\n    JOIN fact_orders AS o\\n      ON o.order_id = oi.order_id\\n    JOIN dim_products AS p\\n      ON p.product_id = oi.product_id\\n    WHERE o.status = 'completed'\\n    GROUP BY p.category\\n),\\ncategory_rates AS (\\n    SELECT\\n        s.category,\\n        s.sold_qty,\\n        COALESCE(r.returned_qty, 0) AS returned_qty,\\n        ROUND(COALESCE(r.returned_qty, 0)::DECIMAL / NULLIF(s.sold_qty, 0), 4) AS return_rate\\n    FROM sold AS s\\n    LEFT JOIN returned AS r\\n      ON r.category = s.category\\n)\\nSELECT\\n    category,\\n    sold_qty,\\n    returned_qty,\\n    return_rate\\nFROM category_rates\\nORDER BY return_rate DESC, category ASC\",\"summary\":\"分别按品类聚合完成订单的售出数量与退货数量，再计算四舍五入至 4 位的退货率，并按退货率降序、品类升序排列。\",\"assumptions\":[\"无退货记录的品类 returned_qty 及 return_rate 均按 0 处理。\",\"退货率按退货数量除以完成订单售出数量计算。\"]}"},"seq":125}
