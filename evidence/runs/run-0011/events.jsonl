{"case_run_id":18,"created_at":"2026-08-29T16:27:37.748756","event_type":"provider.delta","level":"info","message":"","model_run_id":11,"payload":{"text":"{\"sql\":\"WITH product_revenue AS (\\n    SELECT\\n        p.category,\\n        p.product_id,\\n        p.product_name,\\n        SUM(oi.quantity * oi.unit_price - oi.discount_amount) AS net_revenue\\n    FROM fact_order_items AS oi\\n    JOIN fact_orders AS o\\n      ON oi.order_id = o.order_id\\n    JOIN dim_products AS p\\n      ON oi.product_id = p.product_id\\n    WHERE o.status = 'completed'\\n    GROUP BY p.category, p.product_id, p.product_name\\n), ranked_products AS (\\n    SELECT\\n        category,\\n        product_id,\\n        product_name,\\n        net_revenue,\\n        ROW_NUMBER() OVER (\\n            PARTITION BY category\\n            ORDER BY net_revenue DESC, product_id ASC\\n        ) AS rank_no\\n    FROM product_revenue\\n)\\nSELECT\\n    category,\\n    product_id,\\n    product_name,\\n    net_revenue,\\n    rank_no\\nFROM ranked_products\\nWHERE rank_no <= 3\\nORDER BY category ASC, rank_no ASC;\",\"summary\":\"汇总完成订单中各商品的净销售额，并使用 ROW_NUMBER 选出每个品类净销售额前三的商品；同额时按 product_id 升序排名。\",\"assumptions\":[\"仅统计至少出现在一笔完成订单中的商品；不足三个商品的品类返回其全部符合条件的商品。\"]}"},"seq":90}
