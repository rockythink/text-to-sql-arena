---
import ModelIdentity from "./ModelIdentity.astro";
import { formatDate, runSlug, scoreText, statusLabel, type EvidenceIndexRun, type RunReport } from "../lib/evidence";
interface Props { index: EvidenceIndexRun; report: RunReport; compact?: boolean; }
const { index, report, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const modelSearch = report.models.map((model) => `${model.name} ${model.resolved_model_id ?? model.requested_model_id}`).join(" ");
---
<article class:list={["run-card", { compact }]} data-run-card data-status={report.status} data-search={`${report.id} ${modelSearch}`.toLowerCase()}>
  <div class="run-card-index"><span>运行</span><b>#{String(report.id).padStart(4, "0")}</b></div>
  <div class="run-card-body">
    <div class="run-card-meta"><span class:list={["status-chip", `status-${report.status}`]}>{statusLabel(report.status)}</span><time datetime={report.created_at}>{formatDate(report.created_at)}</time><span>{report.selected_case_keys.length} 题</span></div>
    <h2 class="model-name-list">{report.models.length ? report.models.map((model) => <ModelIdentity name={model.name} modelId={model.resolved_model_id ?? model.requested_model_id} adapterKind={model.adapter_kind}/>) : "没有完成模型输出"}</h2>
    <div class="score-line">{report.models.map((model) => <div><ModelIdentity compact name={model.name} modelId={model.resolved_model_id ?? model.requested_model_id} adapterKind={model.adapter_kind}/><b>{scoreText(model.official_score)}</b><span>综合得分</span></div>)}{!report.models.length && <div><span>得分不可用</span></div>}</div>
    <div class="hash-line"><span>题库</span><code>{report.suite_content_hash.slice(0, 14)}</code><span>证据</span><code>{index.bundle_sha256.slice(0, 14)}</code></div>
  </div>
  <a class="run-card-link" href={`${base}runs/${runSlug(report.id)}/`} aria-label={`查看运行 ${report.id} 的完整报告`}>完整报告 <span>→</span></a>
</article>
