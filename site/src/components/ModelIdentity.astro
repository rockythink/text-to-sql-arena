---
import { displayModelName } from "../lib/evidence";
interface Props { name: string; modelId?: string | null; adapterKind?: string | null; compact?: boolean; }
const { name, modelId, adapterKind, compact = false } = Astro.props;
const value = [name, modelId, adapterKind].filter(Boolean).join(" ").toLowerCase();
const brand = /claude|anthropic/.test(value) ? "anthropic" : /gemini|google/.test(value) ? "gemini" : /gpt|openai|codex|luna|sol/.test(value) ? "openai" : null;
---
<span class:list={["model-identity", { compact }]}>
  <span class:list={["model-logo", brand ? `brand-${brand}` : "brand-generic"]} aria-hidden="true">
    {brand ? <img src={`${import.meta.env.BASE_URL}brands/${brand}.svg`} alt=""/> : <b>{displayModelName(name).slice(0, 1).toUpperCase()}</b>}
  </span>
  <span>{displayModelName(name)}</span>
</span>
