---
import type { DerivedResultVerdict } from "../lib/evidence";

interface Option { label: string; verdict: DerivedResultVerdict; }
interface Props { roundKey: string; options: Option[]; }
const { roundKey, options } = Astro.props;
---
<section class="audience-guess" data-guess={roundKey}>
  <div>
    <h3>结果预测（可选）</h3>
    <p>选择你认为本题全部作答结果正确的模型。选择仅保存在本机，不上传、不计票；也可直接展开结果对比。这不是盲测。</p>
  </div>
  <div class="guess-options" role="group" aria-label="选择你猜测结果正确的模型">
    {options.map((option, index) => (
      <button type="button" data-choice={index} data-label={option.label} data-verdict={option.verdict}>模型 {String.fromCharCode(65 + index)}</button>
    ))}
    <button type="button" data-choice="unknown">都不确定</button>
  </div>
  <p class="guess-result" data-guess-result aria-live="polite">选择后显示根据评分分项派生的结果比较。</p>
  <details data-guess-evidence><summary>查看结果对比</summary><slot/></details>
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-guess]")) {
    const result = root.querySelector<HTMLElement>("[data-guess-result]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-choice]")];
    const reveal = (selected: HTMLButtonElement) => {
      for (const button of buttons) button.setAttribute("aria-pressed", String(button === selected));
      const evidencePanel = root.querySelector<HTMLDetailsElement>("[data-guess-evidence]");
      if (evidencePanel) evidencePanel.open = true;
      const evidence = buttons
        .filter((button) => button.dataset.verdict)
        .map((button) => `${button.dataset.label}：${button.dataset.verdict === "correct" ? "全部作答结果正确" : button.dataset.verdict === "incorrect" ? "作答未全部正确" : "证据不足"}`)
        .join("；");
      if (result) result.textContent = `结果比较（根据评分分项派生）：${evidence}。`;
      try { localStorage.setItem(`sql-arena-guess:${root.dataset.guess}`, selected.dataset.choice ?? "unknown"); } catch {}
    };
    for (const button of buttons) button.addEventListener("click", () => reveal(button));
    try {
      const saved = localStorage.getItem(`sql-arena-guess:${root.dataset.guess}`);
      const selected = buttons.find((button) => button.dataset.choice === saved);
      if (selected) reveal(selected);
    } catch {}
  }
</script>
