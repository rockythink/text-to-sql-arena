---
import RunCard from "../components/RunCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { displayModelName, formatDate, getEvidenceIndex, getRuns, runSlug, scoreText } from "../lib/evidence";

const [index, runs] = await Promise.all([getEvidenceIndex(), getRuns()]);
const latest = runs.find(({ report }) => report.models.some((model) => model.official_score != null)) ?? runs[0];
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="首页" description="固定题库、确定性执行、完整公开证据的 Text-to-SQL 模型评测。" current="home">
  <section class="hero">
    <div class="hero-copy">
      <h1 class="hero-title">Text-to-SQL 评测记录</h1>
      <p class="page-lede">公开展示题库版本、模型输出、SQL 执行结果、评分和资源消耗。当前收录 {index.run_count} 次运行。</p>
    </div>
    <aside class="hero-rail" aria-label="公开证据统计">
      <div class="rail-label">数据概况</div>
      <div class="rail-stats">
        <div class="rail-stat"><b>{index.run_count}</b><span>运行记录</span></div>
        <div class="rail-stat"><b>{index.suite_count}</b><span>题库版本</span></div>
        <div class="rail-stat"><b>100</b><span>评分上限</span></div>
      </div>
      <div class="rail-proof">证据格式<code>{index.schema_version}</code></div>
    </aside>
  </section>

  {latest && <section class="section">
    <div class="section-heading">
      <div><h2>最近运行</h2></div>
      <p>显示本次运行的模型、综合得分、配置快照和原始证据入口。</p>
    </div>
    <div class="latest-match">
      <div class="match-number"><span>RUN / {formatDate(latest.report.created_at)}</span><b>{String(latest.report.id).padStart(2, "0")}</b></div>
      <div class="match-body">
        <div class="match-meta"><span>{latest.report.fairness.comparison_mode.toUpperCase()}</span><code>{latest.report.suite_content_hash.slice(0, 18)}</code></div>
        <div class="match-models">
          {latest.report.models.map((model) => <article class="match-model">
            <small>{model.resolved_model_id ?? model.requested_model_id}</small>
            <h3>{displayModelName(model.name)}</h3>
            <strong>{scoreText(model.official_score)}</strong>
          </article>)}
        </div>
        <div class="evidence-actions">
          <a class="button-link primary" href={`${base}runs/${runSlug(latest.report.id)}/`}>打开完整报告 ↗</a>
          <a class="button-link" href="https://github.com/rockythink/text-to-sql-arena/tree/main/evidence">查看原始证据</a>
        </div>
      </div>
    </div>
  </section>}


  <section class="section">
    <div class="section-heading">
      <div><h2>运行记录</h2></div>
      <p>列表包含完成、失败、取消和中断的运行；缺失字段保持为空。</p>
    </div>
    <div class="run-list">
      {runs.slice(0, 4).map(({ index: runIndex, report }) => <RunCard index={runIndex} report={report} compact />)}
    </div>
    <div class="evidence-actions"><a class="button-link" href={`${base}runs/`}>查看全部运行 →</a></div>
  </section>

</SiteLayout>
