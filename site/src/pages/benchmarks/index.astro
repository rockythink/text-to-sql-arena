---
import ChallengeProposal from "../../components/ChallengeProposal.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { formatDate, getSuites, githubEvidenceRoot } from "../../lib/evidence";
const suites = (await getSuites()).sort((a, b) => b.version - a.version);
---
<SiteLayout title="测试用例" description="已发布的题库版本、数据、参考结果与测试用例提案。" current="benchmarks">
  <header class="page-frame benchmark-hero">
    <h1 class="page-title">测试用例</h1>
    <p class="page-lede">每个版本包含 Schema、种子数据、语义口径、Prompt、金标与比较规则。已发布版本不可修改，修正需发布新版本。</p>
  </header>

  <section class="section">
    <div class="section-heading"><h2>已发布版本</h2><p>源文件包含各版本的题目、数据和金标结果。</p></div>
    <div class="suite-list">
      {suites.map((suite) => <article class="suite-card">
        <header><p>版本 {String(suite.version).padStart(2, "0")} · {formatDate(suite.published_at)}</p><h2>{suite.name}</h2><p>{suite.description}</p></header>
        <dl class="suite-facts"><div><dt>业务题</dt><dd>{suite.gold_count}</dd></div><div><dt>金标结果行</dt><dd>{suite.row_count}</dd></div><div><dt>方言</dt><dd>{suite.dialect}</dd></div></dl>
        <div class="suite-contract"><p><span>执行引擎</span><code>DuckDB {suite.duckdb_version}</code></p><p><span>解析器</span><code>SQLGlot {suite.sqlglot_version}</code></p><p><span>评分器</span><code>{suite.scorer_version}</code></p></div>
        <details class="hash-details"><summary>查看内容与发布摘要</summary><p><span>Content SHA-256</span><code>{suite.content_hash}</code></p><p><span>Bundle SHA-256</span><code>{suite.bundle_sha256}</code></p></details>
        <div class="story-actions"><a class="button-link primary" href={`${githubEvidenceRoot}/${suite.path}`}>浏览题目、数据与金标 ↗</a></div>
      </article>)}
    </div>
  </section>

  <section class="section boundary-section">
    <div class="section-heading"><h2>模型输入与评分流程</h2><p>模型输入不包含 Reference SQL 或金标结果。</p></div>
    <ol class="method-grid">
      <li><b>01</b><h3>冻结题库</h3><p>维护者用 Reference SQL 生成并验证金标结果。</p></li>
      <li><b>02</b><h3>裁剪输入</h3><p>模型只收到结构、语义、业务问题、方言规则和输出合同。</p></li>
      <li><b>03</b><h3>本地执行</h3><p>生成 SQL 在固定 DuckDB 数据上运行，再与金标结果比较。</p></li>
      <li><b>04</b><h3>发布证据</h3><p>运行结束后才公开 Prompt、输出、评分、日志与摘要。</p></li>
    </ol>
  </section>

  <section class="section"><ChallengeProposal /></section>
</SiteLayout>
