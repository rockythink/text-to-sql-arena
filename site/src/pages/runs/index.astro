---
import RunCard from "../../components/RunCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getEvidenceIndex, getRuns } from "../../lib/evidence";
const [index, runs] = await Promise.all([getEvidenceIndex(), getRuns()]);
---
<SiteLayout title="评测报告" description={`浏览 ${index.run_count} 次已发布运行，包括完成、失败、取消与中断记录。`} current="runs">
  <header class="page-frame archive-hero">
    <p class="kicker">完整档案 · 不只保留好看的结果</p>
    <h1 class="page-title">每一场，都能回到证据</h1>
    <p class="page-lede">共 {index.run_count} 次公开运行。综合得分不是正确率；失败、取消和中断同样保留，便于判断一次结论的真实边界。</p>
    <div class="run-toolbar" data-run-toolbar>
      <label><span>搜索运行或模型</span><input type="search" name="query" placeholder="例如：18、Luna、Sol" autocomplete="off" /></label>
      <label><span>运行状态</span><select name="status"><option value="all">全部状态</option><option value="completed">完成</option><option value="completed_with_errors">完成但有错误</option><option value="failed">失败</option><option value="cancelled">已取消</option><option value="interrupted">被中断</option></select></label>
    </div>
  </header>
  <section class="section archive-list">
    <p class="result-count" data-result-count>显示 {runs.length} 条</p>
    <div class="run-list">{runs.map(({ index: runIndex, report }) => <RunCard index={runIndex} report={report} />)}</div>
    <p class="empty-note" data-empty hidden>没有符合当前条件的运行。</p>
  </section>
</SiteLayout>
<script>
  const toolbar = document.querySelector<HTMLElement>("[data-run-toolbar]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-run-card]")];
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  if (toolbar && count && empty) {
    const query = toolbar.querySelector<HTMLInputElement>('input[name="query"]');
    const status = toolbar.querySelector<HTMLSelectElement>('select[name="status"]');
    const applyFilters = () => {
      const needle = query?.value.trim().toLowerCase() ?? "";
      const selectedStatus = status?.value ?? "all";
      let visible = 0;
      for (const card of cards) {
        const show = (!needle || (card.dataset.search ?? "").includes(needle)) && (selectedStatus === "all" || card.dataset.status === selectedStatus);
        card.hidden = !show;
        if (show) visible += 1;
      }
      count.textContent = `显示 ${visible} 条`;
      empty.hidden = visible !== 0;
    };
    query?.addEventListener("input", applyFilters);
    status?.addEventListener("change", applyFilters);
  }
</script>
